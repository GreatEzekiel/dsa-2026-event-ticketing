{
  "info": {
    "name": "EventPulse Capstone (React + Node + MySQL)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "eventId", "value": "" },
    { "key": "tierId", "value": "" },
    { "key": "bookingRef", "value": "" },
    { "key": "qrToken", "value": "" },
    { "key": "organizerToken", "value": "" },
    { "key": "attendeeToken", "value": "" },
    { "key": "staffToken", "value": "" }
  ],
  "item": [
    {
      "name": "1. Health Check",
      "request": { "method": "GET", "url": "{{baseUrl}}/health" }
    },
    {
      "name": "2. Organizer - Create Demo Account",
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "const res = pm.response.json();",
          "pm.collectionVariables.set('organizerToken', res.user.token);"
        ] }
      }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"organizer+{{$guid}}@example.com\",\n  \"password\": \"CapstoneDemo123!\",\n  \"role\": \"organizer\"\n}" },
        "url": "{{baseUrl}}/api/auth/signup"
      }
    },
    {
      "name": "3. Organizer - Create Event",
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "const res = pm.response.json();",
          "pm.collectionVariables.set('eventId', res.id);"
        ] }
      }],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{organizerToken}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"Lagos Dev & Cloud Summit\",\n  \"city\": \"Lagos\",\n  \"venue\": \"Landmark Centre\",\n  \"startsAt\": \"2030-12-15T10:00:00.000Z\"\n}" },
        "url": "{{baseUrl}}/api/events"
      }
    },
    {
      "name": "4. Organizer - Add Ticket Tier",
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "const res = pm.response.json();",
          "pm.collectionVariables.set('tierId', res.id);"
        ] }
      }],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{organizerToken}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Regular Pass\",\n  \"priceCents\": 1500000,\n  \"capacity\": 50\n}" },
        "url": "{{baseUrl}}/api/events/{{eventId}}/tiers"
      }
    },
    {
      "name": "5. Organizer - Publish Event",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{organizerToken}}" }],
        "url": "{{baseUrl}}/api/events/{{eventId}}/publish"
      }
    },
    {
      "name": "6. Attendee - Create Demo Account",
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "const res = pm.response.json();",
          "pm.collectionVariables.set('attendeeToken', res.user.token);"
        ] }
      }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"attendee+{{$guid}}@example.com\",\n  \"password\": \"CapstoneDemo123!\",\n  \"role\": \"attendee\"\n}" },
        "url": "{{baseUrl}}/api/auth/signup"
      }
    },
    {
      "name": "7. Attendee - Search Events",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/events?city=Lagos&sortBy=price"
      }
    },
    {
      "name": "8. Attendee - View My Bookings",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{attendeeToken}}" }],
        "url": "{{baseUrl}}/api/bookings"
      }
    },
    {
      "name": "9. Attendee - Book Tickets",
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "const res = pm.response.json();",
          "pm.collectionVariables.set('bookingRef', res.reference);"
        ] }
      }],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{attendeeToken}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"tierId\": \"{{tierId}}\",\n  \"quantity\": 2\n}" },
        "url": "{{baseUrl}}/api/bookings"
      }
    },
    {
      "name": "10. Attendee - Pay Booking",
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "const res = pm.response.json();",
          "pm.collectionVariables.set('qrToken', res.qrToken);"
        ] }
      }],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{attendeeToken}}" }
        ],
        "body": { "mode": "raw", "raw": "{ \"simulateDecline\": false }" },
        "url": "{{baseUrl}}/api/bookings/{{bookingRef}}/pay"
      }
    },
    {
      "name": "11. Staff - Create Demo Account",
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "const res = pm.response.json();",
          "pm.collectionVariables.set('staffToken', res.user.token);"
        ] }
      }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"staff+{{$guid}}@example.com\",\n  \"password\": \"CapstoneDemo123!\",\n  \"role\": \"staff\"\n}" },
        "url": "{{baseUrl}}/api/auth/signup"
      }
    },
    {
      "name": "12. Staff - Check In Ticket QR",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{staffToken}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"token\": \"{{qrToken}}\",\n  \"targetEventId\": \"{{eventId}}\"\n}" },
        "url": "{{baseUrl}}/api/checkin"
      }
    }
  ]
}
